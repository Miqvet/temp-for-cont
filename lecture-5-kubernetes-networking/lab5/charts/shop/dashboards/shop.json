{
  "uid": "shop-red",
  "title": "Shop — RED + network (zero trust)",
  "tags": ["lab5", "shop", "red", "networking"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by route",
      "description": "R из RED: скорость пользовательских HTTP-запросов по нормализованным маршрутам.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(shop_api_http_requests_total{job=\"api\",route!=\"/metrics\"}[1m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP 5xx ratio",
      "description": "E из RED: доля ответов 5xx среди бизнес-запросов.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(shop_api_http_requests_total{job=\"api\",status=~\"5..\",route!~\"/health|/metrics\"}[2m])) or vector(0)) / clamp_min((sum(rate(shop_api_http_requests_total{job=\"api\",route!~\"/health|/metrics\"}[2m])) or vector(0)), 0.001)",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request duration p50 / p95 / p99",
      "description": "D из RED: квантили общего распределения latency по histogram buckets всех реплик.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(shop_api_http_request_duration_seconds_bucket{job=\"api\",route!~\"/health|/metrics\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(shop_api_http_request_duration_seconds_bucket{job=\"api\",route!~\"/health|/metrics\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(shop_api_http_request_duration_seconds_bucket{job=\"api\",route!~\"/health|/metrics\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "API scrape targets up",
      "description": "Количество реплик API, с которых Prometheus успешно получает метрики.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 4, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        { "refId": "A", "expr": "sum(up{job=\"api\"})", "legendFormat": "up" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Orders processed in 15m",
      "description": "Прикладной throughput worker, рассчитанный по counter.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 4, "x": 16, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        { "refId": "A", "expr": "sum(increase(shop_worker_orders_processed_total{job=\"worker\"}[15m]))", "legendFormat": "processed" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Worker errors in 15m",
      "description": "Ошибки чтения или обновления заказов worker'ом.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        { "refId": "A", "expr": "sum(increase(shop_worker_processing_errors_total{job=\"worker\"}[15m]))", "legendFormat": "errors" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Postgres connections (app)",
      "description": "cnpg_backends_total for the real app user — the 'connections' alert metric. Excludes CNPG's own internal metrics-exporter connection, which is always present and would otherwise mask a real outage.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "sum by (state) (cnpg_backends_total{usename=\"shop\"})", "legendFormat": "{{state}}" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Calico dataplane failures (Felix)",
      "description": "The closest OSS-Calico proxy for 'traffic denied by policy': if Felix can't apply iptables/ipset updates, the zero-trust matrix may not actually be enforced. True per-packet deny counts aren't exposed without Calico Enterprise.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(felix_int_dataplane_failures{namespace=\"kube-system\"}[5m]))", "legendFormat": "failures/s" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "CoreDNS error ratio",
      "description": "Share of DNS responses that are not NOERROR — the 'DNS health' alert metric. Services resolving each other by name is what makes Part 2's pod-chaos story work at all.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(coredns_dns_responses_total{rcode!=\"NOERROR\"}[5m])) or vector(0)) / clamp_min(sum(rate(coredns_dns_responses_total[5m])), 0.001)",
          "legendFormat": "error ratio"
        }
      ]
    }
  ]
}
